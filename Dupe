-- SHARED: animated rainbow stroke helper
-- ═══════════════════════════════════════════════════════════════════════════════

local function rainbowStroke(stroke, speed)
    speed = speed or 0.004
    task.spawn(function()
        local hue = 0
        while stroke.Parent do
            hue = (hue + speed) % 1
            stroke.Color = Color3.fromHSV(hue, 1, 1)
            task.wait()
        end
    end)
end

