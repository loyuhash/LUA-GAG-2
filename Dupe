local function showResult()
    if not isOn then return end

    pcall(function()
        local old = hui:FindFirstChild("TraitResultOverlay")
        if old then old:Destroy() end
    end)

    local rsg = Instance.new("ScreenGui")
    rsg.Name = "TraitResultOverlay"
    rsg.ResetOnSpawn = false
    rsg.IgnoreGuiInset = true
    rsg.DisplayOrder = 999999
    rsg.Parent = hui

    local label = Instance.new("TextLabel")
    label.AnchorPoint = Vector2.new(0, 0.5)
    label.Position = UDim2.new(0.08, 0, 0.48, 0)
    label.Size = UDim2.fromOffset(340, 70)
    label.BackgroundTransparency = 1
    label.Font = Enum.Font.GothamBold
    label.TextSize = 54
    label.TextColor3 = Color3.fromRGB(255, 255, 255)
    -- FIXED: Removed 💎 and ✨
    label.Text = "Unique"
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.TextTransparency = 1
    label.Parent = rsg

    local grad = Instance.new("UIGradient", label)
    grad.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0,    Color3.fromRGB(148, 50,  180)),
        ColorSequenceKeypoint.new(0.45, Color3.fromRGB(180, 60,  120)),
        ColorSequenceKeypoint.new(1,    Color3.fromRGB(210, 100, 30)),
    })
    grad.Rotation = 0

    task.spawn(function()
        while label.Parent and label.TextTransparency < 1 do
            TweenService:Create(grad,
                TweenInfo.new(0.9, Enum.EasingStyle.Linear),
                { Offset = Vector2.new(0.6, 0) }
            ):Play()
            task.wait(0.9)
            grad.Offset = Vector2.new(-0.6, 0)
        end
    end)

    TweenService:Create(label,
        TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
        { TextTransparency = 0 }
    ):Play()

    TweenService:Create(label,
        TweenInfo.new(2.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
        { Position = UDim2.new(0.08, 0, 0.44, 0) }
    ):Play()

    task.delay(2, function()
        if not rsg.Parent then return end
        TweenService:Create(label,
            TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
            { TextTransparency = 1 }
        ):Play()
        task.wait(0.35)
        pcall(function() rsg:Destroy() end)
    end)
end

-- ─── HOOK REROLL BUTTONS ──────────────────────────────────────────────────────
local hooked = {}

local function hookButtons()
    local roots = { CoreGui, localPlayer:FindFirstChild("PlayerGui") }
    for _, root in ipairs(roots) do
        if not root then continue end
        for _, desc in ipairs(root:GetDescendants()) do
            if desc:IsA("TextButton")
                and not hooked[desc]
                and (
                    desc.Text == "Reroll"
                    or desc.Text == "Reroll Token"
                    or desc.Text == "Robux Reroll"
                )
            then
                hooked[desc] = true
                desc.MouseButton1Click:Connect(function()
                    task.delay(0.08, showResult)
                end)
                desc.TouchTap:Connect(function()
                    task.delay(0.08, showResult)
                end)
            end
        end
    end
end

task.spawn(function()
    while sg.Parent do
        task.wait(0.5)
        pcall(hookButtons)
    end
end)

_G.UniqueLuckOn = function() return isOn end
